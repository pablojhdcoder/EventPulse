export RELEASE_NODE="${RELEASE_NAME}@${HOSTNAME}"
case "$RELEASE_COMMAND" in
  start|daemon|start_iex|daemon_iex)
    # Demo Docker: libcluster + PubSub PG2 requieren distribución Erlang.
    if [ -n "${CLUSTER_PEER_HOSTS:-}" ]; then
      export RELEASE_DISTRIBUTION=name
    else
      export RELEASE_DISTRIBUTION=none
    fi
    ;;
  *)
    export RELEASE_DISTRIBUTION=name
    ;;
esac
