<div style="max-width:600px; margin:2rem auto; padding:1rem;">
  <a href={~p"/events"} style="color:#2563eb;">← Volver a eventos</a>

  <h1 style="font-size:1.5rem; font-weight:bold; margin-top:1rem;">
    <%= @event.title %>
  </h1>

  <p style="color:#6b7280; margin:0.5rem 0;"><%= @event.description %></p>

  <div style="margin:1rem 0;">
    <strong>Categoría:</strong> <%= @event.category %>
  </div>

  <div style="margin:1rem 0;">
    <strong>Estado actual:</strong>
    <span style={"color: #{status_color(@event.status)}; font-weight:bold;"}>
      <%= @event.status %>
    </span>
  </div>

  <%= if @current_user && @current_user.role == "admin" do %>
    <div style="margin-top:1.5rem;">
      <p style="font-weight:600; margin-bottom:0.5rem;">Cambiar estado:</p>
      <%= for next_status <- Map.get(@valid_transitions, @event.status, []) do %>
        <button phx-click="change_status" phx-value-status={next_status}
          style="background:#16a34a; color:white; padding:0.5rem 1rem; border-radius:0.375rem; border:none; cursor:pointer; margin-right:0.5rem;">
          → <%= next_status %>
        </button>
      <% end %>
      <%= if Map.get(@valid_transitions, @event.status, []) == [] do %>
        <p style="color:#6b7280;">Este evento ya está finalizado.</p>
      <% end %>
    </div>

    <div style="margin-top:1rem;">
      <a href={~p"/events/#{@event.id}/edit"}
        style="background:#d97706; color:white; padding:0.5rem 1rem; border-radius:0.375rem; text-decoration:none;">
        Editar evento
      </a>
    </div>
  <% end %>
</div>