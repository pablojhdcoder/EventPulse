<Layouts.app flash={@flash} current_user={@current_user}>
  <div style="max-width:640px;margin:0 auto;">
    <a href={~p"/events"} style="display:inline-flex;margin-bottom:1rem;font-weight:700;">
      ← Volver a eventos
    </a>

    <.card class="ep-card--elevated">
      <h1 style="font-size:1.65rem;font-weight:800;letter-spacing:-0.03em;margin:0 0 0.35rem;">
        <%= if @event.id, do: "Editar evento", else: "Nuevo evento" %>
      </h1>
      <p style="color:var(--color-text-muted);margin:0 0 1.5rem;">
        Completa los datos principales del evento para que aparezca en el listado.
      </p>

      <.form for={@form} phx-change="validate" phx-submit="save" class="ep-stack">
        <.input field={@form[:title]} type="text" label="Título *" required />

        <.input field={@form[:description]} type="textarea" label="Descripción" />

        <div class="ep-field">
          <label class="ep-label" for="event-category">Categoría *</label>
          <select id="event-category" name="event[category]" class="ep-input" required>
            <option value="">Selecciona una categoría</option>
            <option value="deportes" selected={@form[:category].value == "deportes"}>Deportes</option>
            <option value="musica" selected={@form[:category].value == "musica"}>Música</option>
            <option value="politica" selected={@form[:category].value == "politica"}>Política</option>
            <option value="cultura" selected={@form[:category].value == "cultura"}>Cultura</option>
          </select>
        </div>

        <.input field={@form[:starts_at]} type="datetime-local" label="Fecha de inicio *" required />
        <.input field={@form[:ends_at]} type="datetime-local" label="Fecha de fin" />

        <div class="ep-form-actions">
          <.button type="submit" variant="primary">Guardar</.button>
          <a href={~p"/events"} class="ep-button ep-button--outline">Cancelar</a>
        </div>
      </.form>
    </.card>
  </div>
</Layouts.app>
